# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0
# 콤마 구분. 브라우저에서 API 를 직접 호출하는 Origin 목록
CORS_ORIGINS=http://localhost:3001,http://web.local.dev
# 앞단 리버스 프록시 홉 수 (Nginx 1단 = 1, Ingress + Nginx = 2). req.ip / X-Forwarded-* 신뢰 범위
TRUST_PROXY_HOPS=1

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app
DB_PASSWORD=app_local_password
DB_NAME=app
DB_SSL=false
DB_POOL_MAX=10
DB_RUN_MIGRATIONS=false

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_password
REDIS_DB=0
REDIS_KEY_PREFIX=app:

# ── Health ───────────────────────────────────────────
HEALTH_CHECK_TIMEOUT_MS=1500
HEALTH_MEMORY_RSS_THRESHOLD_MB=512
