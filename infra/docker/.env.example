# docker compose --env-file infra/docker/.env 로 주입 (cp .env.example .env)
COMPOSE_PROJECT_NAME=boilerplate
APP_VERSION=0.1.0

POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_pg_password
POSTGRES_DB=app

REDIS_PASSWORD=change_me_redis_password

# 브라우저가 호출하는 API 주소 (Next.js 빌드 시 번들에 인라인됨)
NEXT_PUBLIC_API_URL=http://api.local.dev
# 호스트에서 접근하는 Nginx 포트
NGINX_HTTP_PORT=80
# 모바일(에뮬레이터/실기기)용 API 포트
NGINX_MOBILE_API_PORT=8080
