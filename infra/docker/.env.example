# docker compose --env-file infra/docker/.env 로 주입 (cp .env.example .env)
COMPOSE_PROJECT_NAME=boilerplate
APP_VERSION=0.1.0

POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_pg_password
POSTGRES_DB=app

REDIS_PASSWORD=change_me_redis_password

# 브라우저가 호출하는 API 주소 (Next.js 빌드 시 번들에 인라인됨)
NEXT_PUBLIC_API_URL=http://api.local.dev
# 호스트에서 접근하는 Nginx 포트
NGINX_HTTP_PORT=80
# 모바일(에뮬레이터/실기기)용 API 포트
NGINX_MOBILE_API_PORT=8080

# ── 프록시 환경에서만 ───────────────────────────────────────────────
# 빌드 컨테이너가 패키지 저장소에 닿지 못할 때(apk/npm DNS 실패) 사용한다.
# HTTP_PROXY / HTTPS_PROXY / NO_PROXY 는 셸 환경변수에서 자동으로 전달되므로 여기 적지 않아도 된다.
# 프록시가 루프백 주소(127.0.0.1:xxxx)면 빌드가 호스트 네트워크를 써야 그 주소에 닿는다.
# DOCKER_BUILD_NETWORK=host
