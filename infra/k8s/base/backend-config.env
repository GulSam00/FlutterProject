# server-api 비밀이 아닌 설정 (configMapGenerator → 내용 해시가 이름에 붙어 변경 시 자동 롤아웃)
# 비밀번호/토큰은 overlays 의 secretGenerator(또는 External Secrets)로 주입한다.
NODE_ENV=production
PORT=3000
APP_VERSION=0.0.0
# Ingress Controller(1홉) 뒤에 위치
TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://web.example.com
DB_PORT=5432
DB_SSL=true
# Pod 수 × DB_POOL_MAX ≤ Postgres max_connections (HPA maxReplicas 기준으로 산정)
DB_POOL_MAX=10
# 다중 레플리카 동시 마이그레이션은 경합/락 유발 → 배포 파이프라인의 별도 Job 에서만 실행
DB_RUN_MIGRATIONS=false
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=app:
# readinessProbe.timeoutSeconds(3s) 보다 짧게 → 항상 앱이 먼저 "어떤 의존성이 느린지" 응답한다
HEALTH_CHECK_TIMEOUT_MS=1500
# limits.memory(512Mi) 의 약 80% → OOMKill 전에 NotReady 로 트래픽에서 제외
HEALTH_MEMORY_RSS_THRESHOLD_MB=410
# V8 힙 상한 < 컨테이너 메모리 상한 (네이티브/버퍼 메모리 여유분 확보)
NODE_OPTIONS=--max-old-space-size=384
