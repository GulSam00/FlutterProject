{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  // 이 파일들이 바뀌면 "모든" 태스크 캐시를 무효화한다.
  // (예: 공통 tsconfig 옵션 변경은 모든 패키지의 빌드 결과를 바꿀 수 있다)
  "globalDependencies": [".npmrc", "packages/tsconfig/*.json"],
  // NODE_ENV 가 다르면 산출물이 다르다 → 해시에 포함하지 않으면 dev 빌드 캐시가 prod 에 재사용되는 사고 발생
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      // ^build: 내 의존 패키지(@repo/shared-types 등)의 build 를 먼저 실행 (위상 정렬)
      "dependsOn": ["^build"],
      // 테스트/문서/로컬 env 변경만으로는 빌드 캐시를 깨지 않는다 → 불필요한 재빌드 방지
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.test.ts", "!**/*.md", "!.env*"],
      // 캐시 대상 산출물. .next/cache 는 용량이 크고 재현 불필요하므로 제외
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // NEXT_PUBLIC_* 는 번들에 인라인된다 → 값이 다르면 반드시 다른 캐시 키를 써야
      // "dev API 주소가 박힌 번들이 prod 에 배포되는" 사고를 막을 수 있다
      "env": ["NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // Next.js 는 build 중 .next/types 를 재생성한다. 같은 패키지의 typecheck 가 병렬로 돌면
    // 파일이 사라진 순간을 읽어 간헐적으로 실패(flaky)하므로 build 이후로 순서를 강제한다.
    "@app/client-web#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "lint": {
      // type-aware 린트는 의존 패키지의 .d.ts 가 필요하다
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      // 장기 실행 프로세스는 캐시 불가 / 다른 태스크가 의존할 수 없도록 persistent 지정
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
